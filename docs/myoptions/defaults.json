[ { "title": "User Defaults",
    "info": "This sets first-boot defaults and are still changeable in the WebUI.\nThese are only defaults and will not be applied if the setting is found in NVS Preferences.\nPreferences are only saved to NVS if changed from the default." },

  { "type": "locale_select", "name": "Display Locale", "define": "DSP_LOCALE" },
  { "type": "timezone_select", "name": "Time Zone", "define": "TIMEZONE" },
  {
    "name": "Clock 12 Hour Mode",
    "define": "CLOCK_TWELVE", "type": "boolean", "optional": true, "default": false
  },
  {
    "name": "Numbered Playlist",
    "define": "NUMBERED_PLAYLIST", "type": "boolean", "optional": true, "default": false
  },
  {
    "name": "One Click Switch",
    "define": "ONE_CLICK_SWITCH", "type": "boolean", "optional": true, "default": false
  },
  {
