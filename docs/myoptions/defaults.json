  {
    "name": "SD Shuffle",
    "define": "SD_SHUFFLE", "type": "boolean", "optional": true, "default": false
  },
  {
    "name": "Show Buffer Bar",
    "define": "SHOW_BUFFERBAR", "type": "boolean", "optional": true, "default": false
  },
  {
    "name": "Show VU Meter",
    "define": "SHOW_VU_METER", "type": "boolean", "optional": true, "default": false
